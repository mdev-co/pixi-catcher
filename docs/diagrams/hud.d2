direction: down
vars: {
  d2-config: {
    theme-id: 8
    pad: 40
  }
}

title: |md
  # PR #5 - HUD: follows the world scale, never knows Game
  Hud draws a bar with the score and lives on top of the world. main.ts feeds it plain numbers, so Game holds no reference to Hud.
| {near: top-center}

startup: "STARTUP (once): font first, then Hud, then stage order" {
  style.fill: "#f9fafb"
  style.stroke: "#374151"
  preload: "index.html\n<link rel=preload>\nPressStart2P-Regular.woff2" {style.fill: "#ffffff"}
  config: "config/game.ts, HUD\nbarHeight 48, gap 64\nstyle: Press Start 2P, 16px" {style.fill: "#fef3c7"; style.stroke: "#92400e"}
  loader: "fonts.ts, loadHudFont()\nawait document.fonts.load(\n'16px Press Start 2P')" {style.fill: "#ffffff"}
  boot: "main.ts, bootstrap()\nawait textures + loadHudFont()\nnew World(), new Hud(world)" {style.fill: "#e0f2fe"; style.stroke: "#075985"}
  stage: "app.stage, children in draw order\n1. world.container\n2. hud.container: drawn last,\nitems never cover it" {shape: cylinder; style.fill: "#e0f2fe"; style.stroke: "#075985"}
  preload -> loader
  config -> loader: "font family, size"
  loader -> boot: "font ready"
  config -> boot: "style, barHeight, gap"
  boot -> stage: "addChild x2"
}

runtime: "RUNTIME: Hud follows the world and reads plain values, Game never calls it" {
  style.fill: "#ecfdf5"
  style.stroke: "#065f46"
  resize: "main.ts on renderer 'resize'\n1. world.fitToScreen(app.screen)\n2. hud.layout()" {shape: oval; style.fill: "#e0f2fe"; style.stroke: "#075985"}
  ticker: "main.ts on app.ticker, every frame\n1. game.update(deltaMS / 1000)\n2. hud.update(game.score, game.lives)" {shape: oval; style.fill: "#e0f2fe"; style.stroke: "#075985"}
  fit: "World.fitToScreen(screen)\nscale = screen.height / 720\nwidth = screen.width / scale" {style.fill: "#f3f4f6"; style.stroke: "#374151"}
  layout: "Hud.layout()\ncontainer.scale = world.scale\ncontainer.y = world.offsetY\nbar: full world width x barHeight\nscore: anchor (1, 0.5), gap/2 left of centre\nlives: anchor (0, 0.5), gap/2 right of centre" {style.fill: "#6ee7b7"}
  game: "Game.update(dt)\nexposes score and lives as getters\nholds no reference to Hud" {style.fill: "#f3f4f6"; style.stroke: "#374151"}
  update: "Hud.update(score, lives)\ntext.text assigned only\nwhen the value changes" {style.fill: "#6ee7b7"}
  parts: "bar: Graphics\nscoreText, livesText: Text" {style.fill: "#d1fae5"}
  resize -> fit: "1"
  fit -> layout: "2: scale, width, height"
  ticker -> game: "1"
  ticker -> update: "2: plain values"
  layout -> parts: "places, scales"
  update -> parts: "sets text, visibility"
}

rule: "RULE: Text in PIXI is a bitmap rendered once.\nThe font must be loaded before the first Text exists,\nand text.text is assigned only on change." {
  shape: page
  style.fill: "#e0f2fe"
  style.stroke: "#075985"
}

startup -> runtime: "then" {style.stroke-width: 3}
runtime -> rule
